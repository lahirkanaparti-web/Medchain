# Ethereum RPC Configuration (Alchemy / Infura / Sepolia)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# MedChainRegistry Smart Contract Address on Sepolia
CONTRACT_ADDRESS=0x6Df7A20bb095063aA17b6D65796C4D27Ca21B569

# Deployer / Relayer Private Key (32-byte hex string with role permissions)
DEPLOYER_PRIVATE_KEY=YOUR_SEPOLIA_DEPLOYER_PRIVATE_KEY_HERE

# Pinata IPFS Cloud API Credentials
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET=YOUR_PINATA_API_SECRET
PINATA_JWT=YOUR_PINATA_JWT_TOKEN

# Siamese Neural Network Vision Model Paths
ML_MODEL_PATH=app/models/medchain_siamese_embedding.tflite
ML_BUNDLE_PATH=app/models/medchain_siamese_bundle.joblib

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173
